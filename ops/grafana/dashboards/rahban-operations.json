    {
      "id": 6,
      "title": "HTTP probe latency · P50 / P95",
      "type": "timeseries",
      "description": "Synthetic probe latency, not application request latency.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rahban-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le,service) (rate(rahban_probe_duration_seconds_bucket{service=~\"$service\"}[2m])))",
          "legendFormat": "P50 {{service}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le,service) (rate(rahban_probe_duration_seconds_bucket{service=~\"$service\"}[2m])))",
          "legendFormat": "P95 {{service}}"
